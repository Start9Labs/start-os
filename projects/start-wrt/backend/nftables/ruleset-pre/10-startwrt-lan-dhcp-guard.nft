# Drops DHCP and DHCPv6 server replies, and router advertisements from a
# device outside @ra_allow, switched between bridge ports. The router's own
# leave through the output hook. startwrt fills @ra_allow from
# 11-startwrt-lan-ra-allow.nft.
#
# Raw payloads: bridge-family `meta` and protocol matches need kmod-nft-bridge,
# which the image lacks, and a failed include leaves fw4 with no ruleset.
#
# @th is past any extension headers. Behind one, an advertisement is matched by
# the hop limit hosts require of it rather than by the transport protocol.
table bridge startwrt_lan_guard
delete table bridge startwrt_lan_guard
table bridge startwrt_lan_guard {
	set ra_allow {
		type ether_addr
	}
	chain forward {
		type filter hook forward priority filter; policy accept;
		ether type ip @nh,72,8 17 @th,0,16 67 @th,16,16 68 counter drop
		ether type ip6 @nh,48,8 17 @th,0,16 547 @th,16,16 546 counter drop
		ether type ip6 @nh,48,8 58 @th,0,8 134 ether saddr != @ra_allow counter drop
		ether type ip6 @nh,48,8 { 0, 43, 44, 51, 60 } @nh,56,8 255 @th,0,8 134 ether saddr != @ra_allow counter drop
	}
}
