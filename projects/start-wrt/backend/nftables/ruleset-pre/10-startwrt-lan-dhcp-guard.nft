# Drops DHCP and DHCPv6 server replies and router advertisements switched
# between bridge ports. The router's own leave through the output hook.
#
# Raw payloads: bridge-family `meta` and protocol matches need kmod-nft-bridge,
# which the image lacks, and a failed include leaves fw4 with no ruleset.
table bridge startwrt_lan_guard
delete table bridge startwrt_lan_guard
table bridge startwrt_lan_guard {
	chain forward {
		type filter hook forward priority filter; policy accept;
		ether type ip @nh,72,8 17 @th,0,16 67 @th,16,16 68 counter drop
		ether type ip6 @nh,48,8 17 @th,0,16 547 @th,16,16 546 counter drop
		ether type ip6 @nh,48,8 58 @th,0,8 134 counter drop
	}
}
